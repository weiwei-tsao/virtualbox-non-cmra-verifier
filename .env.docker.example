# .env.docker.example
# Template for local Docker Compose configuration.
# Copy to .env.docker and fill in real values — do NOT commit .env.docker.
#
#   cp .env.docker.example .env.docker

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-project-id

# Base64-encoded service-account.json (preferred — no file mount needed).
# Generate on macOS/Linux:
#   base64 -i apps/api/service-account.json | tr -d '\n'
FIREBASE_CREDS_BASE64=

# ── Smarty API ────────────────────────────────────────────────────────────────
# Multiple accounts for load balancing: SMARTY_AUTH_ID=id1,id2
# Count of IDs and TOKENs must match exactly.
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=
# Set to true to skip real API calls (returns CMRA=Y, RDI=Commercial).
SMARTY_MOCK=false

# ── Frontend API URL ──────────────────────────────────────────────────────────
# Build-time variable baked into the JS bundle by Vite.
# Must be browser-accessible. For local docker-compose with port mapping
# 8080:8080, the default below is correct.
# For production, set to the public API URL, e.g. https://your-api.onrender.com
VITE_API_BASE_URL=http://localhost:8080

# ── Optional feature flags ────────────────────────────────────────────────────
ENABLE_VALIDATION_WORKERS=false
ENABLE_REVALIDATION_CHECKER=false
